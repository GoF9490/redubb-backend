# ============================================================
# 환경변수 예시 (PRD-05 §4.3)
# 사용법: 이 파일을 .env 로 복사한 뒤 값을 교체한다. .env 는 절대 커밋하지 않는다.
# 아래 값은 모두 예시이며, 시크릿은 반드시 실제 값으로 교체해야 한다.
# ============================================================

# 활성 프로파일 (컨테이너: prod / 로컬 IDE: 미지정 시 local)
SPRING_PROFILES_ACTIVE=prod

# --- PostgreSQL (prod 프로파일) ---
DB_HOST=postgres-db
DB_PORT=5432
DB_NAME=streaming_db
DB_USERNAME=streaming_user
DB_PASSWORD=local_secret_pw_123!

# --- Google OAuth2 ---
GOOGLE_CLIENT_ID=123456789-abc.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxx

# --- RustFS (S3 호환 스토리지) ---
# 로컬 IDE 실행 시 STORAGE_ENDPOINT=http://localhost:9000 으로 변경
STORAGE_ENDPOINT=http://rustfs:9000
STORAGE_BUCKET_NAME=audio-storage
STORAGE_REGION=us-east-1
STORAGE_PRESIGNED_EXPIRY_SECONDS=60
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfs_secret_key_123!

# --- JWT (HMAC-SHA256, 32자 이상 랜덤 문자열로 교체) ---
JWT_SECRET_KEY=change-me-to-a-random-string-of-32chars-or-more

# --- OAuth2 로그인 성공 후 리다이렉트 (화이트리스트는 쉼표 구분, 완전 일치) ---
OAUTH2_DEFAULT_REDIRECT_URI=http://localhost/auth/callback
OAUTH2_ALLOWED_REDIRECT_URIS=http://localhost/auth/callback,musicapp://oauth2/callback

# --- FFmpeg ---
FFMPEG_TIMEOUT_MINUTES=3

# --- 미디어 URL 접두어 / CORS (빈 값 = 단일 오리진) ---
# 분리 배포 시 예: https://media.example.com / https://web.example.com
MEDIA_PUBLIC_BASE_URL=
CORS_ALLOWED_ORIGINS=

# ------------------------------------------------------------
# 선택 항목 (기본값이 있으므로 필요할 때만 주석 해제)
# ------------------------------------------------------------
# MAX_UPLOAD_SIZE=100MB
# MAX_REQUEST_SIZE=110MB
# JWT_EXPIRATION_MS=86400000
# AUDIO_WORK_DIR=/tmp/audio-work
# FFMPEG_PATH=/usr/bin/ffmpeg
